# ════════════════════════════════════════════════════════════════════════════════
#  CONFIGURATION FILE
#  Cách dùng:
#    1. Copy file này thành `.env` và sửa giá trị
#    2. Muốn test nội bộ Docker → giữ nguyên các biến INTERNAL_*
#    3. Muốn test với thiết bị ngoài LAN → sửa EXTERNAL_* theo IP/host thực
# ════════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
ENV=local

# ── MySQL Database ─────────────────────────────────────────────────────────────
MYSQL_PORT=3307
MYSQL_DATABASE=ai_vision_db
MYSQL_ROOT_PASSWORD=your_password_here

# ── Host Network (IP LAN của máy chạy Docker) ──────────────────────────────────
# Lấy bằng cách chạy:  ipconfig  (Windows) hoặc  ifconfig  (Linux/Mac)
# Mặc định khi rỗng → container gọi nhau qua service name (DNS nội bộ Docker)
# Khi điền IP → container có thể gọi ngược lại host và thiết bị khác LAN
EXTERNAL_HOST_IP=
EXTERNAL_BASE_URL=

# ════════════════════════════════════════════════════════════════════════════════
#  AI Vision API  (cổng: 8000)
# ════════════════════════════════════════════════════════════════════════════════
SERVICE_AI_VISION=ai-vision
CONTAINER_AI_VISION=fit4110-ai-vision-lab05
IMAGE_AI_VISION=fit4110/ai-vision:lab05
DOCKERFILE_AI_VISION=Dockerfile
AI_VISION_AUTH_TOKEN=local-dev-token-vision

# URL Vision Service cho thiết bị NGOÀI Docker (test camera/IoT thật)
# Ví dụ: http://192.168.1.100:8000  hoặc  https://vision.example.com:8000
AI_VISION_URL_EXTERNAL=

# ════════════════════════════════════════════════════════════════════════════════
#  AI Inference Service  (cổng: 9000)
# ════════════════════════════════════════════════════════════════════════════════
SERVICE_AI_SERVICE=ai-service
CONTAINER_AI_SERVICE=fit4110-ai-lab05
IMAGE_AI_SERVICE=fit4110/ai-service:lab05
DOCKERFILE_AI_SERVICE=Dockerfile.ai-service
AI_SERVICE_PORT=9000

# URL Inference Service cho thiết bị NGOÀI Docker
# Ví dụ: http://192.168.1.100:9000
AI_SERVICE_URL_EXTERNAL=

# ════════════════════════════════════════════════════════════════════════════════
#  Core Business Mock  (cổng: 4012)
# ════════════════════════════════════════════════════════════════════════════════
CONTAINER_CORE_MOCK=fit4110-core-mock-lab05
IMAGE_CORE_MOCK=fit4110/core-business-mock:lab05
DOCKERFILE_CORE_MOCK=Dockerfile.core-mock
CORE_AUTH_TOKEN=lab-token-core
CORE_PORT=4012

# URL Core Mock cho thiết bị NGOÀI Docker
CORE_URL_EXTERNAL=

# ════════════════════════════════════════════════════════════════════════════════
#  Camera Stream Mock  (cổng: 4014)
# ════════════════════════════════════════════════════════════════════════════════
CONTAINER_CAMERA_MOCK=fit4110-camera-mock-lab05
IMAGE_CAMERA_MOCK=fit4110/camera-stream-mock:lab05
DOCKERFILE_CAMERA_MOCK=Dockerfile.camera-mock
CAMERA_AUTH_TOKEN=lab-token-camera
CAMERA_PORT=4014

# URL Camera stream cho thiết bị NGOÀI Docker
# Ví dụ: rtsp://admin:pass@192.168.1.200:554/stream1
CAMERA_STREAM_URL_EXTERNAL=
