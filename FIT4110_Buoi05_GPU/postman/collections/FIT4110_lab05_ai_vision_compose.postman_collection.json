    {
      "name": "01_Functional",
      "item": [
        {
          "name": "POST /vision/detect - happy path with image_url",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            },
            "description": "Phát hiện đối tượng từ image_url - luồng chính Camera → AI Vision",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"cam-gate-01\",\n  \"image_url\": \"http://storage.campus.local/images/frame-001.jpg\",\n  \"timestamp\": \"2026-08-13T07:30:00Z\",\n  \"confidence_threshold\": 0.6\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has detection_id', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('detection_id');",
                  "  pm.expect(json.detection_id).to.match(/^[0-9a-f-]{36}$/);",
                  "});",
                  "pm.test('Response has camera_id', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('camera_id');",
                  "});",
                  "pm.test('Detections array is present', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('detections');",
                  "  pm.expect(json.detections).to.be.an('array');",
                  "});",
                  "pm.test('Each detection has confidence in [0,1]', function () {",
                  "  const json = pm.response.json();",
                  "  json.detections.forEach(function (d) {",
                  "    pm.expect(d.confidence).to.be.at.least(0);",
                  "    pm.expect(d.confidence).to.be.at.most(1);",
                  "  });",
                  "});",
                  "pm.test('Response has model_version', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('model_version');",
                  "});"
                ]
              }
            }
          ]
        },
