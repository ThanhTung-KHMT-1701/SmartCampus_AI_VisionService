              "path": ["vision", "detect"]
            },
            "description": "Auth test thật: không dùng Prefer: code=401. Khi chạy trên mock, test được skip có kiểm soát.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"cam-gate-01\",\n  \"image_url\": \"http://storage.campus.local/images/test.jpg\",\n  \"timestamp\": \"2026-08-13T07:30:00Z\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const env = pm.environment.get('env') || 'mock';",
                  "if (env === 'mock') {",
                  "  pm.test('Skipped on mock: Prism does not enforce real auth', function () {",
                  "    pm.expect(true).to.eql(true);",
                  "  });",
                  "} else {",
                  "  pm.test('Missing token returns 401 or 403', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /vision/detect - invalid token rejected on real service",
          "request": {
            "method": "POST",
