            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            },
            "description": "Token sai phải bị service thật từ chối",
            "body": {
              "mode": "raw",
