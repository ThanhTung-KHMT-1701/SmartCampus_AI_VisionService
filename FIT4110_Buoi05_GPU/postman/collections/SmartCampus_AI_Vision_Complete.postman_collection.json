          "",
          "// Ensure environment variables are set",
          "if (!pm.environment.get('baseUrl')) {",
          "    console.warn('baseUrl not set, using default');",
          "    pm.environment.set('baseUrl', 'http://localhost:8000');",
          "}"
        ]
      }
    },
    {
