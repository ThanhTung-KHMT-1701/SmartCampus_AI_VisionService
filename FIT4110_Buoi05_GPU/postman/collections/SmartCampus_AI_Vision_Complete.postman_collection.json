{
  "info": {
    "name": "SmartCampus AI Vision API - Complete Test Suite",
    "description": "Bộ test hoàn chỉnh cho AI Vision Service API\n\n## Kiến trúc\n- Gateway: http://localhost:8000 (duy nhất cổng public)\n- AI Engine: Internal only (port 9000)\n- MySQL: Internal only (port 3306)\n\n## Authentication\nTất cả endpoints (trừ /health) yêu cầu Bearer Token.\n\n## Test Coverage\n1. Health Check\n2. Object Detection (URL & Base64)\n3. Face Matching\n4. Recent Detections\n5. Detection by ID\n6. Model Info\n\n## RFC 9457 Problem Details\nTất cả lỗi tuân thủ chuẩn RFC 9457 với:\n- type: URI định danh loại lỗi\n- title: Tên lỗi ngắn gọn\n- status: HTTP status code\n- detail: Mô tả chi tiết\n- instance: URI của request gây lỗi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345678"
  },
  "item": [
    {
      "name": "01. Health Check",
      "item": [
        {
          "name": "GET Health - Service OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has correct structure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData).to.have.property('service');",
                  "    pm.expect(jsonData).to.have.property('version');",
                  "    pm.expect(jsonData).to.have.property('modelLoaded');",
                  "    pm.expect(jsonData).to.have.property('time');",
                  "});",
                  "",
                  "pm.test(\"Service is healthy\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "    pm.expect(jsonData.service).to.eql('ai-vision');",
                  "    pm.expect(jsonData.modelLoaded).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Object Detection",
      "item": [
        {
          "name": "POST Detect - Valid Image URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has detection structure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('detection_id');",
                  "    pm.expect(jsonData).to.have.property('camera_id');",
                  "    pm.expect(jsonData).to.have.property('detections');",
                  "    pm.expect(jsonData).to.have.property('risk_level');",
                  "    pm.expect(jsonData).to.have.property('model_version');",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "});",
                  "",
                  "pm.test(\"Detection ID is valid UUID\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.detection_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.environment.set('detectionId', jsonData.detection_id);",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"{{cameraId}}\",\n  \"image_url\": \"{{testImageUrl}}\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"confidence_threshold\": 0.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            }
          }
        },
        {
          "name": "POST Detect - Missing Auth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Error follows RFC 9457\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('type');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData.status).to.eql(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"{{cameraId}}\",\n  \"image_url\": \"{{testImageUrl}}\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            }
          }
        },
        {
          "name": "POST Detect - Invalid Camera ID Format",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Error response has validation details\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('type');",
                  "    pm.expect(jsonData.status).to.eql(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"CAM_INVALID_123\",\n  \"image_url\": \"{{testImageUrl}}\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            }
          }
        },
        {
          "name": "POST Detect - Missing Required Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Error indicates missing fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"{{cameraId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Face Matching",
      "item": [
        {
          "name": "POST Face Match - Valid Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has face match structure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('match_id');",
                  "    pm.expect(jsonData).to.have.property('matched');",
                  "    pm.expect(jsonData).to.have.property('confidence');",
                  "    pm.expect(jsonData).to.have.property('threshold');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData).to.have.property('model_version');",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "});",
                  "",
                  "pm.test(\"Match ID is valid UUID\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.match_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.environment.set('matchId', jsonData.match_id);",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_url\": \"{{testFaceUrl1}}\",\n  \"reference_image_url\": \"{{testFaceUrl2}}\",\n  \"threshold\": 0.75,\n  \"trace_id\": \"trace-{{$randomUUID}}\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vision/face-match",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "face-match"]
            }
          }
        },
        {
          "name": "POST Face Match - Missing Reference Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Error indicates missing reference image\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_url\": \"{{testFaceUrl1}}\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vision/face-match",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "face-match"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Detection Results",
      "item": [
        {
          "name": "GET Recent Detections - Default Limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has pagination structure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData).to.have.property('hasMore');",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Save nextCursor if exists\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.nextCursor) {",
                  "        pm.environment.set('nextCursor', jsonData.nextCursor);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/results/recent?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "results", "recent"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "GET Recent Detections - With Camera Filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All items match camera filter\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.items.length > 0) {",
                  "        jsonData.items.forEach(item => {",
                  "            pm.expect(item.camera_id).to.eql(pm.environment.get('cameraId'));",
                  "        });",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/results/recent?limit=10&camera_id={{cameraId}}",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "results", "recent"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "camera_id",
                  "value": "{{cameraId}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET Detection by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const detectionId = pm.environment.get('detectionId');",
                  "",
                  "if (!detectionId) {",
                  "    console.log('Skipping test: No detection ID available');",
                  "    return;",
                  "}",
                  "",
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Response matches detection ID\", function () {",
                  "        const jsonData = pm.response.json();",
                  "        pm.expect(jsonData.detection_id).to.eql(detectionId);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/detections/{{detectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detections", "{{detectionId}}"]
            }
          }
        },
        {
          "name": "GET Detection by ID - Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error follows RFC 9457\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('type');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData.status).to.eql(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/detections/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detections", "00000000-0000-0000-0000-000000000000"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Model Info",
      "item": [
        {
          "name": "GET Model Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has model info structure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('model_id');",
                  "    pm.expect(jsonData).to.have.property('model_type');",
                  "    pm.expect(jsonData).to.have.property('framework');",
                  "    pm.expect(jsonData).to.have.property('classes');",
                  "    pm.expect(jsonData.classes).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Model classes are valid\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.classes.length > 0) {",
                  "        const firstClass = jsonData.classes[0];",
                  "        pm.expect(firstClass).to.have.property('id');",
                  "        pm.expect(firstClass).to.have.property('name');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/models/info",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "models", "info"]
            }
          }
        }
      ]
    }
  ],
