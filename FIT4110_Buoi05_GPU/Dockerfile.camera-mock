FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup --system camgroup && adduser --system --ingroup camgroup --home /app camuser

RUN pip install --no-cache-dir fastapi uvicorn pydantic

COPY src/side_mocks/ ./side_mocks/

RUN chown -R camuser:camgroup /app
USER camuser

EXPOSE 4014

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4014/health', timeout=3).read()" || exit 1

CMD ["uvicorn", "side_mocks.camera_stream:app", "--host", "0.0.0.0", "--port", "4014"]
