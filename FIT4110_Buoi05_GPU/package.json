{
  "name": "fit4110-lab05-docker-compose-readiness",
  "version": "0.1.0",
  "description": "FIT4110 Lab 05 - Docker Compose readiness and end-to-end verification for Smart Campus services",
  "private": true,
  "scripts": {
    "mock:iot": "prism mock contracts/iot-ingestion.openapi.yaml --host 0.0.0.0 --port 4010",
    "lint:openapi": "spectral lint contracts/*.yaml",
    "compose:build": "docker compose build",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:ps": "docker compose ps",
    "compose:logs": "docker compose logs -f",
    "compose:health": "curl http://localhost:8000/health && curl http://localhost:9000/health",
    "test:compose": "newman run postman/collections/FIT4110_lab05_ai_vision_compose.postman_collection.json -e postman/environments/FIT4110_lab05_compose.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/newman-lab05-compose.xml --reporter-htmlextra-export reports/newman-lab05-compose.html"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.10.0",
    "@stoplight/spectral-cli": "^6.13.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^8.0.1"
  }
}
