# AI Vision Service — runtime configuration (FIT4110 Buổi 05 NoGPU)
# Mỗi biến đều có default an toàn trong docker-compose.yml.
# Copy thành .env và thay token trước khi chia sẻ stack ngoài nhóm.

# --- AI Vision Service ---
APP_HOST=0.0.0.0
APP_PORT=8000
SERVICE_NAME=ai-vision
SERVICE_VERSION=0.5.0
AI_VISION_AUTH_TOKEN=local-dev-token-vision
LOG_LEVEL=INFO

# --- AI YOLOv8 Service ---
YOLO_SERVICE_URL=http://ai-yolo:8000
YOLO_MODEL_NAME=yolov8n
YOLO_INPUT_SIZE=640
YOLO_CONFIDENCE_DEFAULT=0.5

# --- Vision DB (Postgres side-car) ---
VISION_DB_NAME=vision
VISION_DB_USER=vision
VISION_DB_PASSWORD=local-dev-vision
VISION_DB_PATH=/data/vision.db