# AI Vision Service — runtime configuration (FIT4110 Buổi 05 NoGPU)
# Mỗi biến đều có default an toàn trong docker-compose.yml.
# Copy thành .env và thay token trước khi chia sẻ stack ngoài nhóm.

# ═══════════════════════════════════════════════════════════════════════════
#  Gateway Configuration
# ═══════════════════════════════════════════════════════════════════════════
APP_PORT=8000
AI_VISION_AUTH_TOKEN=smartcampus-vision-2026-secure-token

# ═══════════════════════════════════════════════════════════════════════════
#  MySQL Database Configuration
# ═══════════════════════════════════════════════════════════════════════════
MYSQL_ROOT_PASSWORD=SmartCampus2026Secure
MYSQL_DATABASE=ai_vision_db

# ═══════════════════════════════════════════════════════════════════════════
#  Container Names (optional, có defaults)
# ═══════════════════════════════════════════════════════════════════════════
CONTAINER_MYSQL=smartcampus-ai-vision-mysql-nogpu
CONTAINER_AI_VISION_INTERNAL=smartcampus-ai-vision-internal-nogpu
CONTAINER_AI_VISION_GATEWAY=smartcampus-ai-vision-gateway-nogpu

# ═══════════════════════════════════════════════════════════════════════════
#  Image Names (optional, có defaults)
# ═══════════════════════════════════════════════════════════════════════════
IMAGE_AI_VISION_INTERNAL=smartcampus/ai-vision-internal-nogpu:1.0.0
IMAGE_AI_VISION_GATEWAY=smartcampus/ai-vision-gateway-nogpu:1.0.0
