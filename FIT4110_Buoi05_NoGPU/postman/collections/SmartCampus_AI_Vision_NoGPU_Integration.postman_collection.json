              "pm.test('Error message is present', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_url\": \"https://invalid-domain-12345.com/invalid.jpg\",\n  \"camera_id\": \"camera-01\",\n  \"confidence_threshold\": 0.5,\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
        },
        "url": {
          "raw": "{{gateway_url}}/vision/detect",
          "host": ["{{gateway_url}}"],
          "path": ["vision", "detect"]
