          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401 or 422', function () {",
              "    pm.expect([401, 422]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('Error message is present', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid-token",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_url\": \"https://ultralytics.com/images/bus.jpg\",\n  \"camera_id\": \"camera-01\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
        },
        "url": {
          "raw": "{{gateway_url}}/vision/detect",
          "host": ["{{gateway_url}}"],
          "path": ["vision", "detect"]
        }
      }
    },
