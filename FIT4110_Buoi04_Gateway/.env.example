# Smart Campus API Gateway (FIT4110_Buoi04_Gateway)
# All tokens below are lab placeholders. Copy this file to `.env` and
# replace each *_TOKEN before sharing the stack or pushing any image.

# Gateway-facing token (client must present this Bearer to the Gateway).
GATEWAY_AUTH_TOKEN=local-dev-token-gateway

# Tokens of downstream services — Gateway uses them to call upstream.
# Hidden from clients; injected into env only.
AI_VISION_AUTH_TOKEN=local-dev-token-vision
CORE_AUTH_TOKEN=lab-token-core
CAMERA_AUTH_TOKEN=lab-token-camera
