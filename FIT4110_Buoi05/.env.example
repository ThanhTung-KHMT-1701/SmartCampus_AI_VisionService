# AI Vision Service — auth token required by /vision/* endpoints.
AI_VISION_AUTH_TOKEN=local-dev-token-vision

# External mocks (NOT packaged in this lab). These are the real LAN IPs
# of the Camera Stream and Core Business services running on the host.
# AI Vision does not call them yet — kept here for forward compatibility.
CAMERA_STREAM_BASE_URL=http://192.168.137.115:8001
CORE_BUSINESS_BASE_URL=http://192.168.137.79:8001

# MySQL connection settings (from HOST - for MySQL Workbench, etc.)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_vision_db
