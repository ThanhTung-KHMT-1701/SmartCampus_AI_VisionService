            "description": "Face match with threshold 0.75 — confidence 0.93 >= threshold => matched=true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_url\": \"http://192.168.137.115:8001/cameras/cam-lab05-gate/frames/latest\",\n  \"reference_image_url\": \"http://192.168.137.79:8001/profiles/student-001.jpg\",\n  \"threshold\": 0.75,\n  \"trace_id\": \"trace-lab05-001\",\n  \"timestamp\": \"2026-08-25T08:30:00Z\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has match_id (UUID)', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('match_id');",
