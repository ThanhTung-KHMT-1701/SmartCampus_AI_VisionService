    {
      "name": "03_Negative",
      "item": [
        {
          "name": "POST /vision/detect - missing required camera_id returns 422",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            },
            "description": "Missing camera_id triggers FastAPI validation error (RFC 9457 ProblemDetails).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_url\": \"http://192.168.137.115:8001/cameras/cam-lab05-gate/frames/latest\",\n  \"timestamp\": \"2026-08-25T08:00:00Z\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing camera_id returns 422', function () {",
                  "  pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Error follows ProblemDetails shape', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('type');",
                  "  pm.expect(json).to.have.property('title');",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 599);",
                  "});",
                  "pm.test('Error includes errors array with field info', function () {",
                  "  const json = pm.response.json();",
