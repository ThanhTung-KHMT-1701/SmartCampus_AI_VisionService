          ]
        },
        {
          "name": "POST /vision/detect - missing token returns 401 on real service",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/detect",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "detect"]
            },
            "description": "Auth test thật: service Docker phải tự validate Bearer token. Không dùng Prism mock.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"cam-lab05-gate\",\n  \"image_url\": \"http://192.168.137.115:8001/cameras/cam-lab05-gate/frames/latest\",\n  \"timestamp\": \"2026-08-25T08:00:00Z\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing token returns 401 on real Docker service', function () {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Error follows ProblemDetails shape', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('type');",
                  "  pm.expect(json).to.have.property('title');",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 599);",
                  "});"
                ]
              }
            }
          ]
