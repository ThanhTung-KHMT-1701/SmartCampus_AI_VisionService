{
  "id": "fit4110-lab05-lan-remote",
  "name": "FIT4110 Lab05 LAN Remote (from another machine)",
  "values": [
    {
      "key": "env",
      "value": "lan",
      "type": "default",
      "enabled": true
    },
    {
      "key": "baseUrl",
      "value": "http://192.168.137.XXX:8000",
      "type": "default",
      "enabled": true,
      "description": "AI Vision Docker service accessed from another machine on the LAN. Replace 192.168.137.XXX with the actual host IP."
    },
    {
      "key": "authToken",
      "value": "local-dev-token-vision",
      "type": "default",
      "enabled": true
    },
    {
      "key": "cameraBaseUrl",
      "value": "http://192.168.137.115:8001",
      "type": "default",
      "enabled": true
    },
    {
      "key": "cameraToken",
      "value": "lab-token-camera",
      "type": "default",
      "enabled": true
    },
    {
      "key": "coreBaseUrl",
      "value": "http://192.168.137.79:8001",
      "type": "default",
      "enabled": true
    },
    {
      "key": "coreToken",
      "value": "lab-token-core",
      "type": "default",
      "enabled": true
    },
    {
      "key": "tracePrefix",
      "value": "fit4110-lab05-lan",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
