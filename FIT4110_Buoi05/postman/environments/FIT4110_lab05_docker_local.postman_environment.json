{
  "id": "fit4110-lab05-docker-local",
  "name": "FIT4110 Lab05 Docker Real Service",
  "values": [
    {
      "key": "env",
      "value": "docker",
      "type": "default",
      "enabled": true
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "default",
      "enabled": true,
      "description": "AI Vision Service running in Docker container. Published port 8000 on host."
    },
    {
      "key": "authToken",
      "value": "local-dev-token-vision",
      "type": "default",
      "enabled": true,
      "description": "AI Vision service token — matches AI_VISION_AUTH_TOKEN in .env"
    },
    {
      "key": "cameraBaseUrl",
      "value": "http://192.168.137.115:8001",
      "type": "default",
      "enabled": true,
      "description": "Camera Stream mock running on host LAN IP. Used for consumer-side smoke tests."
    },
    {
      "key": "cameraToken",
      "value": "lab-token-camera",
      "type": "default",
      "enabled": true,
      "description": "Camera Stream mock token — for consumer-side smoke tests."
    },
    {
      "key": "coreBaseUrl",
      "value": "http://192.168.137.79:8001",
      "type": "default",
      "enabled": true,
      "description": "Core Business mock running on host LAN IP. Forward-compatibility."
    },
    {
      "key": "coreToken",
      "value": "lab-token-core",
      "type": "default",
      "enabled": true,
      "description": "Core Business mock token."
    },
    {
      "key": "tracePrefix",
      "value": "fit4110-lab05",
      "type": "default",
      "enabled": true,
      "description": "Prefix for X-Trace-Id header in pre-request script."
    }
  ],
  "_postman_variable_scope": "environment"
}
