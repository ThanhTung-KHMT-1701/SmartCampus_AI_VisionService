{
  "name": "fit4110_lab04_ai_vision_docker",
  "version": "0.4.0",
  "private": true,
  "description": "FIT4110 Lab 04 - Docker packaging for team-vision (AI Vision Service + side mocks).",
  "scripts": {
    "mock:vision": "prism mock contracts/ai-vision.openapi.yaml --host 0.0.0.0 --port 4011",
    "lint:vision": "spectral lint contracts/ai-vision.openapi.yaml --ruleset .spectral.yaml 2>/dev/null || spectral lint contracts/ai-vision.openapi.yaml",
    "test:vision:mock": "newman run postman/collections/FIT4110_lab04_ai_vision.postman_collection.json -e postman/environments/FIT4110_lab04_ai_vision_mock.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/newman-vision-mock.xml --reporter-htmlextra-export reports/newman-vision-mock.html",
    "test:vision:local": "newman run postman/collections/FIT4110_lab04_ai_vision.postman_collection.json -e postman/environments/FIT4110_lab04_ai_vision_local.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/newman-vision-local.xml --reporter-htmlextra-export reports/newman-vision-local.html",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.15.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^7.2.0"
  }
}
