# AI Vision Service (team-vision) — runtime configuration.
# Each variable has a safe local default inside docker-compose.yml.
# Copy this file to .env and replace tokens before sharing the stack.

# AI Vision Service
APP_HOST=0.0.0.0
APP_PORT=8000
AI_VISION_AUTH_TOKEN=local-dev-token-vision

# Core Business side mock
CORE_AUTH_TOKEN=lab-token-core

# Camera Stream side mock
CAMERA_AUTH_TOKEN=lab-token-camera
